{
  "name": "stjernhem-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Webbplats för Stjernhem Rehabilitering & Hälsa AB",
  "scripts": {
    "dev": "vite",
    "build": "npm run pages && tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit false --pretty",
    "images": "node scripts/fetch-images.mjs",
    "brand": "node scripts/make-brand-assets.mjs",
    "qa": "node scripts/check-site.mjs",
    "qa:shots": "node scripts/shoot-sections.mjs",
    "pages": "node scripts/make-pages.mjs",
    "qa:perf": "node scripts/measure-perf.mjs",
    "qa:form": "node scripts/check-form.mjs",
    "qa:rubriker": "node scripts/check-headings.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "puppeteer-core": "^25.7.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
